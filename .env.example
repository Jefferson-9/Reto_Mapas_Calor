# Copia este archivo como .env y reemplaza TODOS los valores. Nunca subas .env a Git.

# --- Django ---
DJANGO_SETTINGS_MODULE=config.settings.development
DJANGO_SECRET_KEY=reemplaza-con-una-clave-larga-y-aleatoria
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend,frontend
# Orígenes permitidos (CORS y verificación de Origin en el refresh del token)
DJANGO_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Clave HMAC para la huella de la cédula (no se guarda la cédula completa)
CEDULA_HMAC_KEY=reemplaza-con-otra-clave-larga-y-aleatoria

# --- Base de datos (PostgreSQL 16 + PostGIS) ---
POSTGRES_DB=coac_mapas
POSTGRES_USER=coac
POSTGRES_PASSWORD=reemplaza-esta-contrasena
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Contraseña de las cuentas demo del seed (opcional; si se omite se genera una aleatoria y se muestra una vez)
SEED_DEMO_PASSWORD=

# --- Frontend (Vite) ---
# Estilo del mapa base (MapLibre). Por defecto OpenFreeMap, sin clave.
VITE_MAP_STYLE_URL=https://tiles.openfreemap.org/styles/positron
